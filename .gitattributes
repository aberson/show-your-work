# Header-contract fixtures are byte-exact LF test inputs; never convert them on checkout.
tests/fixtures/bad-headers/*.mmd text eol=lf
tests/fixtures/garbage/*.mmd text eol=lf
tests/fixtures/good/*.mmd text eol=lf
tests/fixtures/over-budget/*.mmd text eol=lf
tests/fixtures/good/*.md text eol=lf
# Synthetic realistic fixtures (P6: never real coding-root content). LF-pinned, except the
# *-crlf.mmd edge case, which must stay byte-exact CRLF (-text: no conversion either way).
tests/fixtures/realistic/*.mmd text eol=lf
tests/fixtures/realistic/*.md text eol=lf
tests/fixtures/realistic/*-crlf.mmd -text
# Layout sidecar fixtures and the Phase 1 report goldens (Phase 2 Step 8) are byte-exact LF inputs;
# a CRLF variant is generated in a tmp copy inside the test, never committed.
tests/fixtures/layout/** text eol=lf
# init templates and this repo's dogfooded docs/workflows are copied / compared byte-for-byte.
templates/workflows/* text eol=lf
docs/workflows/*.mmd text eol=lf
docs/workflows/*.md text eol=lf
docs/workflows/*.json text eol=lf
